APP_ENV=dev
APP_PUBLIC_URL=https://travel-sync.example.com
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=base64:replace-with-base64-encoded-32-byte-key

APP_DISTRIBUTION=marketplace
BITRIX24_CLIENT_ID=local.00000000000000.00000000
BITRIX24_CLIENT_SECRET=replace-with-bitrix24-app-secret
BITRIX24_SCOPE=crm,im,user_basic,userfieldconfig
BITRIX24_OAUTH_SERVER=https://oauth.bitrix24.tech/

DATABASE_DSN=mysql:host=127.0.0.1;port=3306;dbname=travel_sync;charset=utf8mb4
DATABASE_USER=travel_sync
DATABASE_PASSWORD=replace-with-a-strong-database-password

SYNC_INTERVAL_MINUTES=15
DATA_RETENTION_DAYS=90
HEALTH_CHECK_TOKEN=replace-with-at-least-24-random-characters
SUPPORT_EMAIL=support@example.com
PRIVACY_URL=https://travel-sync.example.com/privacy
